
{
  "$schema": "https://opencode.ai/config.json",

  "update": "notify",

  "permissions": [
    // Project inspection
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },

    // Protect sensitive files
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*secret*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pfx",
      "effect": "deny"
    },

    // Require approval for file changes
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },

    // Require approval for shell commands
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },

    // Allow safe Git inspection
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },

    // Require approval for Git commits
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "ask"
    },

    // Block potentially destructive Git commands
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },

    // Ask for  common Windows deletion commands
    {
      "action": "shell",
      "resource": "Remove-Item *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "del *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rmdir *",
      "effect": "ask"
    }
  ]
}
